{
  "name": "nusra-tax-notary",
  "version": "1.0.0",
  "description": "Nusra Tax & Notary — trust-first, mobile-first website built with Next.js App Router + Payload CMS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "payload:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload:migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "payload:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "tsx scripts/seed.ts",
    "verify:no-placeholders": "node scripts/verify-no-placeholders.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@react-email/components": "1.0.12",
    "@tailwindcss/postcss": "4.3.3",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.20.0",
    "server-only": "0.0.1",
    "sharp": "0.34.2",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6"
  }
}
